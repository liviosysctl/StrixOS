# Boot splash. Generated from theme.script, render.py fills in the colors.
# Same layout as the Strix documents: everything left-aligned, the wordmark,
# a thin red line below it. A short red segment runs along the line while
# the system boots. It is an activity indicator, not a progress bar: Plymouth
# can only guess how long a boot takes, and the guess was visibly wrong.

Window.SetBackgroundTopColor(@BG_R@, @BG_G@, @BG_B@);
Window.SetBackgroundBottomColor(@BG_R@, @BG_G@, @BG_B@);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
unit = screen_h / 100;
left = Math.Int(screen_w * 0.12);

text_size = Math.Int(Math.Max(14, unit * 2.2));
font = "Inter " + text_size;

# Wordmark
wordmark_image = Image("wordmark.png");
wordmark_h = Math.Int(unit * 9);
wordmark_w = Math.Int(wordmark_image.GetWidth() * wordmark_h / wordmark_image.GetHeight());
wordmark_sprite = Sprite(wordmark_image.Scale(wordmark_w, wordmark_h));
wordmark_y = Math.Int(screen_h * 0.42 - wordmark_h);
wordmark_sprite.SetPosition(left, wordmark_y, 10);

# Red line: a faint track with a moving segment on top
accent = Image("accent.png");
line_w = Math.Int(Math.Max(wordmark_w, screen_w * 0.22));
line_h = Math.Int(Math.Max(2, unit * 0.35));
line_y = wordmark_y + wordmark_h + Math.Int(unit * 2.5);

track_sprite = Sprite(accent.Scale(line_w, line_h));
track_sprite.SetPosition(left, line_y, 10);
track_sprite.SetOpacity(0.25);

segment_w = Math.Int(line_w * 0.25);
segment_sprite = Sprite();
segment_sprite.SetPosition(left, line_y, 11);

# One pass along the line takes about 1.6 s at Plymouth's 50 refreshes per second
segment_step = (line_w + segment_w) / 80;
segment_pos = 0 - segment_w;
waiting_for_passphrase = 0;

fun refresh_callback() {
  if (global.waiting_for_passphrase) {
    segment_sprite.SetOpacity(0);
    return;
  }

  global.segment_pos = global.segment_pos + segment_step;
  if (global.segment_pos > line_w) {
    global.segment_pos = 0 - segment_w;
  }

  # Only draw the part of the segment that lies on the line
  start = Math.Max(0, global.segment_pos);
  end = Math.Min(line_w, global.segment_pos + segment_w);
  if (end - start < 1) {
    segment_sprite.SetOpacity(0);
    return;
  }
  segment_sprite.SetImage(accent.Scale(Math.Int(end - start), line_h));
  segment_sprite.SetX(left + Math.Int(start));
  segment_sprite.SetOpacity(1);
}
Plymouth.SetRefreshFunction(refresh_callback);

# Passphrase: label, bullets, a red line as the field
prompt_y = line_y + Math.Int(unit * 6);

label_sprite = Sprite();
label_sprite.SetPosition(left, prompt_y, 10);

bullets_sprite = Sprite();
bullets_sprite.SetPosition(left, prompt_y + Math.Int(text_size * 2), 10);

field_sprite = Sprite(accent.Scale(line_w, Math.Max(1, Math.Int(line_h / 2))));
field_sprite.SetPosition(left, prompt_y + Math.Int(text_size * 4), 10);
field_sprite.SetOpacity(0);

fun password_callback(prompt, bullets) {
  global.waiting_for_passphrase = 1;

  label_sprite.SetImage(Image.Text("Passphrase", @FG_R@, @FG_G@, @FG_B@, 0.7, font));
  label_sprite.SetOpacity(1);

  # A space without bullets, so Image.Text returns an image
  dots = "";
  for (i = 0; i < bullets; i++) {
    dots = dots + "•";
  }
  if (bullets == 0) {
    dots = " ";
  }
  bullets_sprite.SetImage(Image.Text(dots, @FG_R@, @FG_G@, @FG_B@, 1, font));
  bullets_sprite.SetOpacity(1);

  field_sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(password_callback);

fun normal_callback() {
  global.waiting_for_passphrase = 0;

  label_sprite.SetOpacity(0);
  bullets_sprite.SetOpacity(0);
  field_sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(normal_callback);

# Messages (e.g. a wrong passphrase) bottom left, subdued
message_sprite = Sprite();
message_sprite.SetPosition(left, Math.Int(screen_h * 0.88), 10);

fun message_callback(text) {
  message_sprite.SetImage(Image.Text(text, @FG_R@, @FG_G@, @FG_B@, 0.6, font));
}
Plymouth.SetMessageFunction(message_callback);
