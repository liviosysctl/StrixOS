# tokens.json of the theme engine -> a Zed theme family (schema v0.2.0).
#   jq --arg name NAME -f theme.jq tokens.json
# Colors a theme from outside may lack fall back to the ten every theme has.
.colors as $c
| (.terminal // {}) as $t
| def pick(names): [names[] | $c[.] // empty][0];
  def alpha(color; a): (color[0:7]) + a;
  {
    bg: $c.background,
    surface: $c.surface,
    raised: pick(["surface-raised", "surface"]),
    sunken: pick(["surface-sunken", "background"]),
    border: $c.border,
    strong: pick(["border-strong", "text-muted"]),
    text: $c.text,
    muted: $c["text-muted"],
    faint: pick(["text-faint", "text-muted"]),
    accent: $c.accent,
    accent_text: pick(["accent-text", "accent"]),
    accent_soft: pick(["accent-soft", "surface"]),
    error: $c.error,
    warning: $c.warning,
    success: pick(["success", "accent"]),
    info: pick(["info", "focus"]),
    selection: ($t.selection // pick(["accent-soft", "surface"])),
    keyword: pick(["syntax-keyword", "accent-text", "accent"]),
    string: pick(["syntax-string", "text"]),
    number: pick(["syntax-number", "warning"]),
    func: pick(["syntax-function", "text"]),
    type: pick(["syntax-type", "focus"]),
    constant: pick(["syntax-constant", "accent-text", "accent"]),
    comment: pick(["syntax-comment", "text-muted"]),
    operator: pick(["syntax-operator", "text-muted"])
  } as $p
| (($t.palette // []) as $pal
   | ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"] as $names
   | [range(0; ($pal | length))]
   | map({
       key: ("terminal.ansi." + (if . < 8 then $names[.] else "bright_" + $names[. - 8] end)),
       value: $pal[.]
     })
   | from_entries) as $ansi
| {
    "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
    name: $name,
    author: $name,
    themes: [
      {
        name: $name,
        appearance: (if .appearance == "light" then "light" else "dark" end),
        style: ({
          "background": $p.bg,
          "surface.background": $p.surface,
          "elevated_surface.background": $p.raised,
          "panel.background": $p.surface,
          "panel.focused_border": $p.accent,
          "pane.focused_border": $p.border,
          "border": $p.border,
          "border.variant": $p.border,
          "border.focused": $p.accent,
          "border.selected": $p.accent,
          "border.disabled": $p.border,
          "element.background": $p.surface,
          "element.hover": $p.raised,
          "element.active": $p.selection,
          "element.selected": $p.selection,
          "element.disabled": $p.surface,
          "ghost_element.background": "#00000000",
          "ghost_element.hover": $p.raised,
          "ghost_element.active": $p.selection,
          "ghost_element.selected": $p.selection,
          "drop_target.background": alpha($p.accent; "33"),
          "text": $p.text,
          "text.muted": $p.muted,
          "text.placeholder": $p.faint,
          "text.disabled": $p.faint,
          "text.accent": $p.accent_text,
          "icon": $p.text,
          "icon.muted": $p.muted,
          "icon.disabled": $p.faint,
          "icon.accent": $p.accent_text,
          "status_bar.background": $p.surface,
          "title_bar.background": $p.surface,
          "title_bar.inactive_background": $p.bg,
          "toolbar.background": $p.bg,
          "tab_bar.background": $p.surface,
          "tab.active_background": $p.bg,
          "tab.inactive_background": $p.surface,
          "search.match_background": alpha($p.accent; "55"),
          "scrollbar.thumb.background": alpha($p.strong; "66"),
          "scrollbar.thumb.hover_background": $p.strong,
          "scrollbar.track.background": "#00000000",
          "editor.background": $p.bg,
          "editor.foreground": $p.text,
          "editor.gutter.background": $p.bg,
          "editor.subheader.background": $p.surface,
          "editor.active_line.background": $p.surface,
          "editor.highlighted_line.background": $p.surface,
          "editor.line_number": $p.faint,
          "editor.active_line_number": $p.accent_text,
          "editor.invisible": $p.border,
          "editor.wrap_guide": $p.border,
          "editor.active_wrap_guide": $p.strong,
          "editor.indent_guide": $p.border,
          "editor.indent_guide_active": $p.strong,
          "editor.document_highlight.read_background": alpha($p.accent; "22"),
          "editor.document_highlight.write_background": alpha($p.accent; "33"),
          "link_text.hover": $p.info,
          "terminal.background": ($t.background // $p.bg),
          "terminal.foreground": ($t.foreground // $p.text),
          "terminal.bright_foreground": ($t.foreground // $p.text),
          "terminal.dim_foreground": $p.muted,
          "error": $p.error,
          "error.background": alpha($p.error; "22"),
          "error.border": $p.error,
          "warning": $p.warning,
          "warning.background": alpha($p.warning; "22"),
          "warning.border": $p.warning,
          "success": $p.success,
          "success.background": alpha($p.success; "22"),
          "success.border": $p.success,
          "info": $p.info,
          "info.background": alpha($p.info; "22"),
          "info.border": $p.info,
          "hint": $p.muted,
          "hint.background": $p.surface,
          "hint.border": $p.border,
          "created": $p.success,
          "modified": $p.warning,
          "deleted": $p.error,
          "conflict": $p.warning,
          "renamed": $p.info,
          "ignored": $p.faint,
          "hidden": $p.faint,
          "predictive": $p.faint,
          "unreachable": $p.faint,
          "players": [
            { cursor: $p.accent, selection: alpha($p.selection; "cc"), background: $p.accent }
          ],
          "syntax": {
            "attribute": { color: $p.constant },
            "boolean": { color: $p.constant },
            "comment": { color: $p.comment, font_style: "italic" },
            "comment.doc": { color: $p.comment, font_style: "italic" },
            "constant": { color: $p.constant },
            "constructor": { color: $p.type },
            "embedded": { color: $p.text },
            "emphasis": { font_style: "italic" },
            "emphasis.strong": { font_weight: 700 },
            "function": { color: $p.func },
            "keyword": { color: $p.keyword },
            "label": { color: $p.keyword },
            "link_text": { color: $p.info },
            "link_uri": { color: $p.info },
            "number": { color: $p.number },
            "operator": { color: $p.operator },
            "property": { color: $p.text },
            "punctuation": { color: $p.operator },
            "punctuation.bracket": { color: $p.operator },
            "punctuation.delimiter": { color: $p.operator },
            "string": { color: $p.string },
            "string.escape": { color: $p.number },
            "string.regex": { color: $p.number },
            "string.special": { color: $p.number },
            "tag": { color: $p.keyword },
            "title": { color: $p.text, font_weight: 700 },
            "type": { color: $p.type },
            "variable": { color: $p.text },
            "variable.special": { color: $p.constant }
          }
        } + $ansi)
      }
    ]
  }
